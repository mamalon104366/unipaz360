<?xml version="1.0" encoding="utf-8"?>
<!--
  Fuente de paquetes para compilar la app de Windows. El plugin video_player_win baja la
  biblioteca Microsoft.Windows.ImplementationLibrary con nuget.exe; si el PC no tiene
  fuentes configuradas, NuGet falla con "primarySources". Este archivo vale para todo
  lo que se compila dentro de app/ y no toca la configuración del equipo.
-->
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
